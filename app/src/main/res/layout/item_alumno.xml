<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/brand_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtNombreCompleto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Guillermo Pereyra" />

        <TextView
            android:id="@+id/txtDniAlumno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/brand_text_secondary"
            tools:text="DNI: 12345678" />

        <TextView
            android:id="@+id/txtTelefonoAlumno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_secondary"
            tools:text="Teléfono: 987654321" />

        <TextView
            android:id="@+id/txtCorreoAlumno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_secondary"
            tools:text="Correo: alumno@correo.com" />

        <TextView
            android:id="@+id/txtDireccionAlumno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_secondary"
            tools:text="Dirección: Lima" />

        <TextView
            android:id="@+id/txtFechaNacimientoAlumno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_secondary"
            tools:text="Fecha de nacimiento: 01-01-2005" />

        <TextView
            android:id="@+id/txtCarreraAlumno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_secondary"
            tools:text="Carrera: Ingeniería de Software" />

        <TextView
            android:id="@+id/txtCicloEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            tools:text="Ciclo: III | Estado: Activo" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
